<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MYR-346 — the FULL-MANUAL twin of ExportOptions.plist, for exporting an
	     archive that was signed with `CODE_SIGN_STYLE=Manual` (RELEASING.md §3b).
	     Use it when automatic signing cannot resolve a profile: an Xcode signed
	     out of the team account, or an App Store Connect API key without
	     cloud-signing rights.

	     The profile is named by UUID, not by name, ON PURPOSE. Two installed
	     profiles are both called "MyRoboTaxi App Store" — the pre-Associated-
	     Domains one (747ad8bd…) and the regenerated one below — so a
	     name match is ambiguous and resolves on creation date, which is a
	     tiebreak rather than a guarantee. A UUID cannot pick the wrong one.

	     If this profile is ever regenerated again (any new capability requires
	     it), the UUID here must be updated to match; the export fails loudly
	     with "no profile matching" rather than silently signing with the old
	     one, which is the behaviour we want. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>NFKX777598</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<!-- MYR-172 — the widget extension is a SECOND signed bundle inside the .ipa,
	     so a full-manual export needs its own profile here. An extension is not
	     covered by the host app's profile: the bundle ids differ, and the export
	     fails with "no profile matching app.myrobotaxi.ios.widgets" rather than
	     silently reusing the app's — which is the behaviour we want.

	     WHAT TO MINT (App ID app.myrobotaxi.ios.widgets):
	       • an App Store distribution profile, Apple Distribution certificate;
	       • NO capabilities. Not Push Notifications, not App Groups, not
	         Associated Domains. The extension declares no entitlements file at
	         all (see project.yml). Live Activities are switched on by the HOST
	         app's NSSupportsLiveActivities Info.plist key, and the Live Activity
	         APNs topic is the HOST's bundle id + ".push-type.liveactivity", so
	         the host's existing aps-environment entitlement authorises the push.
	         Adding capabilities here would put entitlements in the profile that
	         the binary does not claim, which the export then rejects.

	     Until that profile exists this placeholder makes the manual export fail
	     LOUDLY and by name, which is the same choice the app's own UUID comment
	     below documents — a wrong-but-plausible value is the outcome worth
	     preventing. Replace the string with the profile UUID; do not delete the
	     key, or the export will instead fail with a less obvious error about an
	     unsigned nested bundle. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>app.myrobotaxi.ios</key>
		<string>f466e22b-6d46-427e-8415-4dabaed9a7de</string>
		<key>app.myrobotaxi.ios.widgets</key>
		<string>REPLACE-WITH-WIDGETS-PROFILE-UUID</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
